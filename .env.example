# Environment Variables Example
# Copy this file to .env.local for local development
# Copy to .env.production for production deployment

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://academos.or.id
NEXT_PUBLIC_SITE_NAME=Rumah Aletheia

# Contact Information
NEXT_PUBLIC_EMAIL=info@academos.or.id
NEXT_PUBLIC_PHONE=+62-xxx-xxxx-xxxx

# Analytics (Optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Social Media (Optional)
# NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/rumahaletheia
# NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/rumahaletheia
# NEXT_PUBLIC_TWITTER_URL=https://twitter.com/rumahaletheia

# API Keys (if needed)
# API_KEY=your-api-key-here

# Database (if needed)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
